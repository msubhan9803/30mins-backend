{
  "name": "30minbackend",
  "version": "1.0.0",
  "description": "Backend Service for 30mins.com",
  "main": "index.js",
  "engines": {
    "node": ">=10.4.0"
  },
  "type": "module",
  "scripts": {
    "build": "node init && tsc -p .",
    "start": "node init && node --experimental-specifier-resolution=node ./dist/index.js",
    "dev": "node init && npm run build && npm run start",
    "dev:hot": "node init && tsc-watch --onSuccess \"nodemon --experimental-specifier-resolution=node ./dist/index.js\"",
    "start:prod": "node init && SET NODE_ENV=production&& node --experimental-specifier-resolution=node ./dist/index.js",
    "build:watch": "node init && tsc -p . -w",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/30mins/30minbackend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/30mins/30minbackend/issues"
  },
  "homepage": "https://gitlab.com/30mins/30minbackend#readme",
  "dependencies": {
    "@sendgrid/mail": "^7.6.1",
    "@stripe/stripe-js": "^1.29.0",
    "@types/crypto-js": "^4.1.1",
    "@types/lodash": "^4.14.182",
    "agenda": "^4.2.1",
    "apollo-server-core": "^3.6.2",
    "apollo-server-express": "^3.6.2",
    "aws-sdk": "^2.1068.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "cuid": "^2.1.8",
    "dayjs": "^1.10.7",
    "dotenv": "^14.2.0",
    "escape-string-regexp": "^5.0.0",
    "express": "^4.17.2",
    "googleapis": "^100.0.0",
    "graphql": "^16.3.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-upload": "^13.0.0",
    "graphql-ws": "^5.9.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "mongoose": "^6.1.7",
    "node-cron": "^3.0.2",
    "node-fetch": "^3.3.2",
    "socket-io": "^1.0.0",
    "socket.io": "^4.5.1",
    "stripe": "^9.2.0",
    "twilio": "^3.83.2",
    "typescript": "^4.5.5",
    "uuid": "^9.0.0",
    "ws": "^8.8.0",
    "xmlbuilder2": "^3.0.2"
  },
